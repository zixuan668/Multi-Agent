# 复制为 .env 后填写真实服务配置。不要提交或发送密钥。
# 服务须支持 chat/completions 和 response_format=json_object。
MODEL_BASE_URL=https://your-model-service.example/v1
MODEL_API_KEY=replace-with-your-key
MODEL_NAME=your-model-name
MODEL_TIMEOUT_SECONDS=60
MODEL_TEMPERATURE=0.2
# 仅官方 DeepSeek 当前模型支持；默认 low，保留思考及独立策略审查。
# MODEL_REASONING_EFFORT=low
