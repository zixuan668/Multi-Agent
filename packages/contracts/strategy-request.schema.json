{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhice.example/contracts/strategy-request.schema.json",
  "title": "智策营销策略智能体请求",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "agent", "round_no", "attempt_count", "requirements", "strategy", "creative", "feedback", "previous_result", "config_version"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "agent": {"const": "strategy"},
    "round_no": {"type": "integer", "minimum": 1, "maximum": 3},
    "attempt_count": {"type": "integer", "minimum": 1, "maximum": 3},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_name", "product_description", "marketing_goal", "target_audience", "budget", "campaign_period", "special_requirements", "budget_raw"],
      "properties": {
        "product_name": {"type": "string", "minLength": 1, "maxLength": 100},
        "product_description": {"type": "string", "minLength": 1, "maxLength": 5000},
        "marketing_goal": {"type": "string", "minLength": 1, "maxLength": 500},
        "target_audience": {"type": ["string", "null"], "maxLength": 1000},
        "budget": {
          "type": ["object", "null"],
          "required": ["amount", "currency"],
          "properties": {
            "amount": {"type": "number", "minimum": 0, "maximum": 100000000, "multipleOf": 0.01},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
          },
          "additionalProperties": false
        },
        "campaign_period": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["duration_days"], "properties": {"duration_days": {"type": "integer", "minimum": 1, "maximum": 365}}}, {"type": "object", "additionalProperties": false, "required": ["start_date", "end_date"], "properties": {"start_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "end_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}]},
        "special_requirements": {"type": ["string", "null"], "maxLength": 2000},
        "budget_raw": {"type": ["string", "null"], "maxLength": 200}
      }
    },
    "strategy": {"type": "null"},
    "creative": {"type": "null"},
    "feedback": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["feedback_id", "evaluation_id", "target_agent", "target_path", "issue", "suggestion", "priority", "resolved"], "properties": {"feedback_id": {"type": "string", "minLength": 1}, "evaluation_id": {"type": "string", "minLength": 1}, "target_agent": {"enum": ["strategy", "creative"]}, "target_path": {"type": "string", "minLength": 1}, "issue": {"type": "string", "minLength": 1, "maxLength": 1000}, "suggestion": {"type": "string", "minLength": 1, "maxLength": 1000}, "priority": {"enum": ["high", "medium", "low"]}, "resolved": {"type": "boolean"}}}},
    "previous_result": {"anyOf": [{"type": "null"}, {"allOf": [{"$ref": "strategy-response.schema.json"}, {"properties": {"status": {"const": "succeeded"}}}]}]},
    "config_version": {"type": "string", "minLength": 1}
  }
}
